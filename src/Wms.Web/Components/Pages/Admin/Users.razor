    private void OpenCreateRoleDialog()
    {
        _isEditingRole = false;
        _roleId = Guid.Empty;
        _roleName = string.Empty;
        _roleDescription = null;
        _roleIsActive = true;
        _roleSelectedPermissions = new List<string>();
        _roleErrorMessage = null;
        _roleDialogVisible = true;
    }

    private void OpenEditRoleDialog(RoleDetailDto role)
    {
        _isEditingRole = true;
        _roleId = role.Id;
        _roleName = role.Name;
        _roleDescription = role.Description;
        _roleIsActive = role.IsActive;
        _roleSelectedPermissions = role.Permissions.ToList();
        _roleErrorMessage = null;
        _roleDialogVisible = true;
    }

    private async Task SaveRole()
    {
        await _roleForm.Validate();
        if (!_isRoleFormValid) return;

        _isSubmittingRole = true;
        _roleErrorMessage = null;

        try
        {
            if (_isEditingRole)
            {
                var command = new UpdateRoleCommand(_roleId, _roleDescription, _roleIsActive, _roleSelectedPermissions);
                var result = await RoleService.UpdateRoleAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Peran dan izin berhasil diperbarui.", Severity.Success);
                    _roleDialogVisible = false;
                    await _roleTable.ReloadServerData();
                    await LoadDependencies();
                }
                else
                {
                    _roleErrorMessage = result.ErrorMessage;
                }
            }
            else
            {
                var command = new CreateRoleCommand(_roleName, _roleDescription, _roleSelectedPermissions);
                var result = await RoleService.CreateRoleAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Peran baru berhasil ditambahkan.", Severity.Success);
                    _roleDialogVisible = false;
                    await _roleTable.ReloadServerData();
                    await LoadDependencies();
                }
                else
                {
                    _roleErrorMessage = result.ErrorMessage;
                }
            }
        }
        catch (Exception ex)
        {
            _roleErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmittingRole = false;
        }
    }

    private async Task ToggleRoleStatus(RoleDetailDto role)
    {
        var result = await RoleService.ToggleRoleStatusAsync(role.Id);
        if (result.Succeeded)
        {
            Snackbar.Add($"Status peran '{role.Name}' berhasil diubah.", Severity.Success);
            await _roleTable.ReloadServerData();
            await LoadDependencies();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Gagal mengubah status peran.", Severity.Error);
        }
    }

    private async Task DeleteRole(RoleDetailDto role)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Konfirmasi Hapus",
            $"Apakah Anda yakin ingin menghapus peran '{role.Name}'?",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed == true)
        {
            var result = await RoleService.DeleteRoleAsync(role.Id);
            if (result.Succeeded)
            {
                Snackbar.Add("Peran berhasil dihapus.", Severity.Success);
                await _roleTable.ReloadServerData();
                await LoadDependencies();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Peran tidak dapat dihapus.", Severity.Error);
            }
        }
    }
