    private void OnRoleToggled(string roleName, bool isChecked)
    {
        if (isChecked && !_uSelectedRoles.Contains(roleName))
            _uSelectedRoles.Add(roleName);
        else if (!isChecked && _uSelectedRoles.Contains(roleName))
            _uSelectedRoles.Remove(roleName);
    }

    private void OnWarehouseToggled(Guid warehouseId, bool isChecked)
    {
        if (isChecked && !_uSelectedWarehouseIds.Contains(warehouseId))
            _uSelectedWarehouseIds.Add(warehouseId);
        else if (!isChecked && _uSelectedWarehouseIds.Contains(warehouseId))
            _uSelectedWarehouseIds.Remove(warehouseId);
    }

