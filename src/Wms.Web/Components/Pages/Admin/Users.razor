    private async Task LoadDependencies()
    {
        _availableRoles = await RoleService.GetActiveRolesAsync();
        _availableWarehouses = await WarehouseService.GetActiveWarehousesAsync();
    }

    // User Operations
    private async Task<TableData<UserDetailDto>> LoadUsersServerData(TableState state, CancellationToken token)
    {
        var query = new GetUsersQuery
        {
            Page = state.Page + 1,
            PageSize = state.PageSize,
            Search = _userSearch,
            Role = _userRoleFilter,
            IsActive = _userStatus,
            SortBy = state.SortLabel,
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        var result = await UserService.GetUsersAsync(query, token);
        return new TableData<UserDetailDto>
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    private Task OnUserSearchChanged(string search)
    {
        _userSearch = search;
        return _userTable.ReloadServerData();
    }

    private Task OnUserRoleFilterChanged(string role)
    {
