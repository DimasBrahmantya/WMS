    private async Task SaveCreateUser()
    {
        await _userForm.Validate();
        if (!_isUserFormValid) return;

        _isSubmittingUser = true;
        _userErrorMessage = null;

        try
        {
            var command = new CreateUserCommand(
                _uUsername,
                _uEmail,
                _uFullName,
                _uPhone,
                _uPassword,
                _uSelectedRoles,
                _uSelectedWarehouseIds);

            var result = await UserService.CreateUserAsync(command);
            if (result.Succeeded)
            {
                Snackbar.Add("Pengguna baru berhasil ditambahkan.", Severity.Success);
                _userCreateDialogVisible = false;
                await _userTable.ReloadServerData();
            }
            else
            {
                _userErrorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _userErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmittingUser = false;
        }
    }

    private async Task SaveEditUser()
    {
        await _userEditForm.Validate();
        if (!_isUserFormValid) return;

        _isSubmittingUser = true;
