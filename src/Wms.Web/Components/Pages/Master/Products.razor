@page "/master/products"
@attribute [Authorize]
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IUnitService UnitService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Data Barang — WMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 py-2 mb-2" />

    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-2">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Data Barang</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Kelola katalog master barang, SKU, barcode, dan batas stok persediaan</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            Tambah Barang
        </MudButton>
    </div>

    <MudCard Elevation="2">
        <MudCardContent Class="pa-4">
            <!-- Filter Bar -->
            <MudGrid Class="mb-3" Spacing="2">
                <MudItem xs="12" sm="4" md="4">
                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Cari SKU, barcode, nama, merek..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  OnDebounceIntervalElapsed="OnSearchChanged"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4" md="3">
                    <MudSelect T="Guid?" Value="_selectedCategory" ValueChanged="OnCategoryChanged" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="Guid?" Value="null">Semua Kategori</MudSelectItem>
                        @foreach (var cat in _availableCategories)
                        {
                            <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" md="2">
                    <MudSelect T="bool?" Value="_selectedStatus" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="bool?" Value="null">Semua Status</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">Aktif</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Nonaktif</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
                    <MudCheckBox T="bool" Value="_lowStockOnly" ValueChanged="OnLowStockChanged" Label="Hanya Berbatas Minimum" Color="Color.Warning" Dense="true" />
                </MudItem>
            </MudGrid>

            <!-- Table -->
            <MudTable ServerData="LoadServerData"
                      @ref="_table"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="sku" T="ProductDto">SKU</MudTableSortLabel></MudTh>
                    <MudTh>Barcode</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="name" T="ProductDto">Nama Barang</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="brand" T="ProductDto">Merek</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="category" T="ProductDto">Kategori</MudTableSortLabel></MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align:right;">Batas Stok</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="isactive" T="ProductDto">Status</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="SKU">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.Sku</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Barcode">
                        <MudText Typo="Typo.caption" Class="font-mono">@(string.IsNullOrWhiteSpace(context.Barcode) ? "-" : context.Barcode)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Nama">
                        <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Merek">@(string.IsNullOrWhiteSpace(context.Brand) ? "-" : context.Brand)</MudTd>
                    <MudTd DataLabel="Kategori">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@context.CategoryName</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Satuan">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@context.UnitAbbreviation</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Batas Stok" Style="text-align:right;">
                        <MudText Typo="Typo.caption">
                            Min: <b>@context.MinStock.ToString("N0")</b> | Max: <b>@(context.MaxStock.HasValue ? context.MaxStock.Value.ToString("N0") : "∞")</b>
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Aktif</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Nonaktif</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align:right;">
                        <MudTooltip Text="Detail">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" OnClick="@(() => OpenDetailDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Ubah">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@(context.IsActive ? "Nonaktifkan" : "Aktifkan")">
                            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                           Size="Size.Small"
                                           Color="@(context.IsActive ? Color.Success : Color.Default)"
                                           OnClick="@(() => ToggleStatus(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Hapus">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteProduct(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Tidak ada data barang yang ditemukan.</MudText>
                    </div>
                </NoRecordsContent>
                <LoadingContent>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                </LoadingContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Baris per halaman:" InfoFormat="{first_item}-{last_item} dari {all_items}" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- Dialog Form Barang -->
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditing ? "Ubah Data Barang" : "Tambah Barang Baru")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_errorMessage</MudAlert>
        }
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formSku"
                                  Label="SKU Barang *"
                                  Placeholder="Contoh: ELK-001"
                                  Required="true"
                                  RequiredError="SKU wajib diisi"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formBarcode"
                                  Label="Barcode / QR (Opsional)"
                                  Placeholder="Contoh: 89910010001"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_formName"
                                  Label="Nama Barang *"
                                  Placeholder="Contoh: Mouse Wireless Ergonomis"
                                  Required="true"
                                  RequiredError="Nama barang wajib diisi"
                                  MaxLength="200"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formBrand"
                                  Label="Merek (Opsional)"
                                  Placeholder="Contoh: LogiTech"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_formCategoryId" Label="Kategori *" Required="true" RequiredError="Kategori wajib dipilih" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var cat in _availableCategories)
                        {
                            <MudSelectItem T="Guid" Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_formUnitId" Label="Satuan Dasar *" Required="true" RequiredError="Satuan wajib dipilih" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var unit in _availableUnits)
                        {
                            <MudSelectItem T="Guid" Value="@unit.Id">@unit.Name (@unit.Abbreviation)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_formMinStock"
                                     Label="Stok Minimum *"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HelperText="Ambang batas peringatan stok rendah" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_formMaxStock"
                                     Label="Stok Maksimum (Opsional)"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HelperText="Kapasitas maksimum gudang" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Domain.Enums.TrackingMethod" @bind-Value="_formTrackingMethod" Label="Metode Pelacakan *" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="Domain.Enums.TrackingMethod" Value="Domain.Enums.TrackingMethod.None">Tanpa Batch (Standar)</MudSelectItem>
                        <MudSelectItem T="Domain.Enums.TrackingMethod" Value="Domain.Enums.TrackingMethod.Batch">Pelacakan Nomor Batch / Lot</MudSelectItem>
                        <MudSelectItem T="Domain.Enums.TrackingMethod" Value="Domain.Enums.TrackingMethod.BatchAndExpiry">Batch + Tanggal Kedaluwarsa (FEFO)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_formDescription"
                                  Label="Deskripsi Barang (Opsional)"
                                  Lines="2"
                                  MaxLength="1000"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @if (_isEditing)
            {
                <MudSwitch @bind-Value="_formIsActive" Label="Status Aktif" Color="Color.Primary" Class="mt-3" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false" Disabled="_isSubmitting">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProduct" Disabled="!_isFormValid || _isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog Detail Barang -->
<MudDialog @bind-Visible="_detailDialogVisible" Options="_detailDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail Barang: @_selectedProduct?.Sku</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedProduct != null)
        {
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Nama Barang</MudText>
                    <MudText Typo="Typo.body1" Class="font-weight-bold">@_selectedProduct.Name</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Barcode</MudText>
                    <MudText Typo="Typo.body1">@(_selectedProduct.Barcode ?? "-")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Kategori</MudText>
                    <MudText Typo="Typo.body1">@_selectedProduct.CategoryName</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Satuan Dasar</MudText>
                    <MudText Typo="Typo.body1">@_selectedProduct.UnitName (@_selectedProduct.UnitAbbreviation)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Merek</MudText>
                    <MudText Typo="Typo.body1">@(_selectedProduct.Brand ?? "-")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Metode Pelacakan</MudText>
                    <MudText Typo="Typo.body1">@_selectedProduct.TrackingMethod.ToString()</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Stok Minimum</MudText>
                    <MudText Typo="Typo.body1">@_selectedProduct.MinStock.ToString("N0") @_selectedProduct.UnitAbbreviation</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Stok Maksimum</MudText>
                    <MudText Typo="Typo.body1">@(_selectedProduct.MaxStock.HasValue ? _selectedProduct.MaxStock.Value.ToString("N0") : "Tidak dibatasi")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Deskripsi</MudText>
                    <MudText Typo="Typo.body2">@(_selectedProduct.Description ?? "-")</MudText>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _detailDialogVisible = false">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<ProductDto> _table = null!;
    private string? _searchString;
    private Guid? _selectedCategory;
    private bool? _selectedStatus;
    private bool _lowStockOnly;

    private IReadOnlyList<CategoryDto> _availableCategories = new List<CategoryDto>();
    private IReadOnlyList<UnitDto> _availableUnits = new List<UnitDto>();

    // Dialog state
    private bool _dialogVisible;
    private bool _isEditing;
    private bool _isSubmitting;
    private bool _isFormValid;
    private string? _errorMessage;
    private MudForm _form = null!;

    // Detail dialog state
    private bool _detailDialogVisible;
    private ProductDto? _selectedProduct;

    private Guid _currentId;
    private string _formSku = string.Empty;
    private string? _formBarcode;
    private string _formName = string.Empty;
    private string? _formDescription;
    private string? _formBrand;
    private Guid _formCategoryId;
    private Guid _formUnitId;
    private decimal _formMinStock = 0;
    private decimal? _formMaxStock;
    private Domain.Enums.TrackingMethod _formTrackingMethod = Domain.Enums.TrackingMethod.None;
    private bool _formIsActive = true;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    private readonly DialogOptions _detailDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Dashboard", href: "/"),
        new("Master Data", href: null, disabled: true),
        new("Data Barang", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        _availableCategories = await CategoryService.GetActiveCategoriesAsync();
        _availableUnits = await UnitService.GetActiveUnitsAsync();
    }

    private async Task<TableData<ProductDto>> LoadServerData(TableState state, CancellationToken token)
    {
        var query = new GetProductsQuery
        {
            Page = state.Page + 1,
            PageSize = state.PageSize,
            Search = _searchString,
            CategoryId = _selectedCategory,
            IsActive = _selectedStatus,
            LowStockOnly = _lowStockOnly ? true : null,
            SortBy = state.SortLabel,
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        var result = await ProductService.GetProductsAsync(query, token);
        return new TableData<ProductDto>
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    private Task OnSearchChanged(string search)
    {
        _searchString = search;
        return _table.ReloadServerData();
    }

    private Task OnCategoryChanged(Guid? categoryId)
    {
        _selectedCategory = categoryId;
        return _table.ReloadServerData();
    }

    private Task OnStatusChanged(bool? status)
    {
        _selectedStatus = status;
        return _table.ReloadServerData();
    }

    private Task OnLowStockChanged(bool lowStock)
    {
        _lowStockOnly = lowStock;
        return _table.ReloadServerData();
    }

    private void OpenCreateDialog()
    {
        _isEditing = false;
        _currentId = Guid.Empty;
        _formSku = string.Empty;
        _formBarcode = null;
        _formName = string.Empty;
        _formDescription = null;
        _formBrand = null;
        _formCategoryId = _availableCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        _formUnitId = _availableUnits.FirstOrDefault()?.Id ?? Guid.Empty;
        _formMinStock = 0;
        _formMaxStock = null;
        _formTrackingMethod = Domain.Enums.TrackingMethod.None;
        _formIsActive = true;
        _errorMessage = null;
        _dialogVisible = true;
    }

    private void OpenEditDialog(ProductDto p)
    {
        _isEditing = true;
        _currentId = p.Id;
        _formSku = p.Sku;
        _formBarcode = p.Barcode;
        _formName = p.Name;
        _formDescription = p.Description;
        _formBrand = p.Brand;
        _formCategoryId = p.CategoryId;
        _formUnitId = p.UnitId;
        _formMinStock = p.MinStock;
        _formMaxStock = p.MaxStock;
        _formTrackingMethod = p.TrackingMethod;
        _formIsActive = p.IsActive;
        _errorMessage = null;
        _dialogVisible = true;
    }

    private void OpenDetailDialog(ProductDto p)
    {
        _selectedProduct = p;
        _detailDialogVisible = true;
    }

    private async Task SaveProduct()
    {
        await _form.Validate();
        if (!_isFormValid) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var command = new UpdateProductCommand(
                    _currentId,
                    _formSku,
                    _formBarcode,
                    _formName,
                    _formDescription,
                    _formBrand,
                    _formCategoryId,
                    _formUnitId,
                    _formMinStock,
                    _formMaxStock,
                    _formTrackingMethod,
                    _formIsActive);

                var result = await ProductService.UpdateProductAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Data barang berhasil diperbarui.", Severity.Success);
                    _dialogVisible = false;
                    await _table.ReloadServerData();
                }
                else
                {
                    _errorMessage = result.ErrorMessage;
                }
            }
            else
            {
                var command = new CreateProductCommand(
                    _formSku,
                    _formBarcode,
                    _formName,
                    _formDescription,
                    _formBrand,
                    _formCategoryId,
                    _formUnitId,
                    _formMinStock,
                    _formMaxStock,
                    _formTrackingMethod);

                var result = await ProductService.CreateProductAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Barang baru berhasil ditambahkan.", Severity.Success);
                    _dialogVisible = false;
                    await _table.ReloadServerData();
                }
                else
                {
                    _errorMessage = result.ErrorMessage;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ToggleStatus(ProductDto product)
    {
        var result = await ProductService.ToggleProductStatusAsync(product.Id);
        if (result.Succeeded)
        {
            Snackbar.Add($"Status barang '{product.Sku}' berhasil diubah.", Severity.Success);
            await _table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Gagal mengubah status barang.", Severity.Error);
        }
    }

    private async Task DeleteProduct(ProductDto product)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Konfirmasi Hapus",
            $"Apakah Anda yakin ingin menghapus barang '{product.Name}' ({product.Sku})?",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed == true)
        {
            var result = await ProductService.DeleteProductAsync(product.Id);
            if (result.Succeeded)
            {
                Snackbar.Add("Barang berhasil dihapus.", Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Barang tidak dapat dihapus.", Severity.Error);
            }
        }
    }
}

