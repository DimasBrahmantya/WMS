@page "/master/customers"
@attribute [Authorize]
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Pelanggan (Customers) — WMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 py-2 mb-2" />

    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-2">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Pelanggan (Customers)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Kelola data pelanggan penerima barang keluar dan tujuan pengiriman</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            Tambah Pelanggan
        </MudButton>
    </div>

    <MudCard Elevation="2">
        <MudCardContent Class="pa-4">
            <!-- Filter Bar -->
            <MudGrid Class="mb-3" Spacing="2">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Cari kode, nama, kontak, email, telp..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  OnDebounceIntervalElapsed="OnSearchChanged"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="bool?" Value="_selectedStatus" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="bool?" Value="null">Semua Status</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">Aktif</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Nonaktif</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- Table -->
            <MudTable ServerData="LoadServerData"
                      @ref="_table"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="code" T="CustomerDto">Kode</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="name" T="CustomerDto">Nama Pelanggan</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="contactperson" T="CustomerDto">Kontak Person</MudTableSortLabel></MudTh>
                    <MudTh>Email & Telepon</MudTh>
                    <MudTh>NPWP</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="isactive" T="CustomerDto">Status</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Kode">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.Code</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Nama">
                        <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Kontak">@(string.IsNullOrWhiteSpace(context.ContactPerson) ? "-" : context.ContactPerson)</MudTd>
                    <MudTd DataLabel="Kontak Info">
                        <MudText Typo="Typo.caption" Class="d-block">@(context.Email ?? "-")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.Phone ?? "-")</MudText>
                    </MudTd>
                    <MudTd DataLabel="NPWP">@(string.IsNullOrWhiteSpace(context.TaxNumber) ? "-" : context.TaxNumber)</MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Aktif</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Nonaktif</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align:right;">
                        <MudTooltip Text="Ubah">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@(context.IsActive ? "Nonaktifkan" : "Aktifkan")">
                            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                           Size="Size.Small"
                                           Color="@(context.IsActive ? Color.Success : Color.Default)"
                                           OnClick="@(() => ToggleStatus(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Hapus">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCustomer(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Tidak ada pelanggan yang ditemukan.</MudText>
                    </div>
                </NoRecordsContent>
                <LoadingContent>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                </LoadingContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Baris per halaman:" InfoFormat="{first_item}-{last_item} dari {all_items}" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- Dialog Form Pelanggan -->
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditing ? "Ubah Pelanggan" : "Tambah Pelanggan Baru")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_errorMessage</MudAlert>
        }
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formCode"
                                  Label="Kode Pelanggan *"
                                  Placeholder="Contoh: CUST-001"
                                  Required="true"
                                  RequiredError="Kode pelanggan wajib diisi"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formName"
                                  Label="Nama Pelanggan *"
                                  Placeholder="Contoh: PT Mitra Niaga"
                                  Required="true"
                                  RequiredError="Nama pelanggan wajib diisi"
                                  MaxLength="200"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formContactPerson"
                                  Label="Kontak Person (Opsional)"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formTaxNumber"
                                  Label="NPWP (Opsional)"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formEmail"
                                  Label="Email"
                                  Placeholder="customer@email.com"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_formPhone"
                                  Label="Nomor Telepon"
                                  Placeholder="081xxxx atau 021-xxxxxx"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_formAddress"
                                  Label="Alamat Lengkap"
                                  Lines="2"
                                  MaxLength="500"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_formNotes"
                                  Label="Catatan Tambahan (Opsional)"
                                  Lines="2"
                                  MaxLength="1000"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @if (_isEditing)
            {
                <MudSwitch @bind-Value="_formIsActive" Label="Status Aktif" Color="Color.Primary" Class="mt-3" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false" Disabled="_isSubmitting">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCustomer" Disabled="!_isFormValid || _isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<CustomerDto> _table = null!;
    private string? _searchString;
    private bool? _selectedStatus;

    private bool _dialogVisible;
    private bool _isEditing;
    private bool _isSubmitting;
    private bool _isFormValid;
    private string? _errorMessage;
    private MudForm _form = null!;

    private Guid _currentId;
    private string _formCode = string.Empty;
    private string _formName = string.Empty;
    private string? _formContactPerson;
    private string? _formEmail;
    private string? _formPhone;
    private string? _formAddress;
    private string? _formTaxNumber;
    private string? _formNotes;
    private bool _formIsActive = true;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Dashboard", href: "/"),
        new("Master Data", href: null, disabled: true),
        new("Pelanggan", href: null, disabled: true)
    };

    private async Task<TableData<CustomerDto>> LoadServerData(TableState state, CancellationToken token)
    {
        var query = new GetCustomersQuery
        {
            Page = state.Page + 1,
            PageSize = state.PageSize,
            Search = _searchString,
            IsActive = _selectedStatus,
            SortBy = state.SortLabel,
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        var result = await CustomerService.GetCustomersAsync(query, token);
        return new TableData<CustomerDto>
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    private Task OnSearchChanged(string search)
    {
        _searchString = search;
        return _table.ReloadServerData();
    }

    private Task OnStatusChanged(bool? status)
    {
        _selectedStatus = status;
        return _table.ReloadServerData();
    }

    private void OpenCreateDialog()
    {
        _isEditing = false;
        _currentId = Guid.Empty;
        _formCode = string.Empty;
        _formName = string.Empty;
        _formContactPerson = null;
        _formEmail = null;
        _formPhone = null;
        _formAddress = null;
        _formTaxNumber = null;
        _formNotes = null;
        _formIsActive = true;
        _errorMessage = null;
        _dialogVisible = true;
    }

    private void OpenEditDialog(CustomerDto c)
    {
        _isEditing = true;
        _currentId = c.Id;
        _formCode = c.Code;
        _formName = c.Name;
        _formContactPerson = c.ContactPerson;
        _formEmail = c.Email;
        _formPhone = c.Phone;
        _formAddress = c.Address;
        _formTaxNumber = c.TaxNumber;
        _formNotes = c.Notes;
        _formIsActive = c.IsActive;
        _errorMessage = null;
        _dialogVisible = true;
    }

    private async Task SaveCustomer()
    {
        await _form.Validate();
        if (!_isFormValid) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var command = new UpdateCustomerCommand(
                    _currentId,
                    _formCode,
                    _formName,
                    _formContactPerson,
                    _formEmail,
                    _formPhone,
                    _formAddress,
                    _formTaxNumber,
                    _formNotes,
                    _formIsActive);

                var result = await CustomerService.UpdateCustomerAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Data pelanggan berhasil diperbarui.", Severity.Success);
                    _dialogVisible = false;
                    await _table.ReloadServerData();
                }
                else
                {
                    _errorMessage = result.ErrorMessage;
                }
            }
            else
            {
                var command = new CreateCustomerCommand(
                    _formCode,
                    _formName,
                    _formContactPerson,
                    _formEmail,
                    _formPhone,
                    _formAddress,
                    _formTaxNumber,
                    _formNotes);

                var result = await CustomerService.CreateCustomerAsync(command);
                if (result.Succeeded)
                {
                    Snackbar.Add("Pelanggan baru berhasil ditambahkan.", Severity.Success);
                    _dialogVisible = false;
                    await _table.ReloadServerData();
                }
                else
                {
                    _errorMessage = result.ErrorMessage;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ToggleStatus(CustomerDto customer)
    {
        var result = await CustomerService.ToggleCustomerStatusAsync(customer.Id);
        if (result.Succeeded)
        {
            Snackbar.Add($"Status pelanggan '{customer.Code}' berhasil diubah.", Severity.Success);
            await _table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Gagal mengubah status pelanggan.", Severity.Error);
        }
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Konfirmasi Hapus",
            $"Apakah Anda yakin ingin menghapus pelanggan '{customer.Name}' ({customer.Code})?",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed == true)
        {
            var result = await CustomerService.DeleteCustomerAsync(customer.Id);
            if (result.Succeeded)
            {
                Snackbar.Add("Pelanggan berhasil dihapus.", Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Pelanggan tidak dapat dihapus.", Severity.Error);
            }
        }
    }
}

