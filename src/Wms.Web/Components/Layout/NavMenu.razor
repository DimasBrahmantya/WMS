@inject NavigationManager Navigation

<MudNavMenu Bordered="true">
    <MudText Typo="Typo.subtitle2" Class="px-4 pt-3 pb-1 text-muted font-weight-bold">UTAMA</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

    <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-1 text-muted font-weight-bold">MASTER DATA (FASE 1)</MudText>
    <MudNavLink Href="/master/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Data Barang</MudNavLink>
    <MudNavLink Href="/master/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Kategori Barang</MudNavLink>
    <MudNavLink Href="/master/units" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Straighten">Satuan Barang</MudNavLink>
    <MudNavLink Href="/master/suppliers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalShipping">Pemasok</MudNavLink>
    <MudNavLink Href="/master/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Pelanggan</MudNavLink>
    <MudNavLink Href="/master/warehouses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Warehouse">Gudang & Rak</MudNavLink>

    <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-1 text-muted font-weight-bold">PERGERAKAN STOK (FASE 1)</MudText>
    <MudNavLink Href="/stock/in" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MoveToInbox">Barang Masuk</MudNavLink>
    <MudNavLink Href="/stock/out" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Outbox">Barang Keluar</MudNavLink>

    <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-1 text-muted font-weight-bold">LAPORAN & AUDIT (FASE 1)</MudText>
    <MudNavLink Href="/reports/stock" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Stok Saat Ini</MudNavLink>
    <MudNavLink Href="/reports/stock-card" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">Kartu Stok</MudNavLink>
    <MudNavLink Href="/reports/valuation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MonetizationOn">Nilai Persediaan</MudNavLink>
    <MudNavLink Href="/admin/audit-logs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Audit Log</MudNavLink>

    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-1 text-muted font-weight-bold">ADMINISTRASI</MudText>
            <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Pengguna & Hak Akses</MudNavLink>
            <MudNavLink Href="/admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Pengaturan Sistem</MudNavLink>
        </Authorized>
    </AuthorizeView>

    <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-1 text-muted font-weight-bold">WORKFLOW OPERASIONAL (FASE 2)</MudText>
    <MudNavLink Href="/operations/purchase-orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Purchase Order (PO)</MudNavLink>
    <MudNavLink Href="/operations/transfers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHoriz">Transfer Antar-Gudang</MudNavLink>
    <MudNavLink Href="/operations/opname" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">Stock Opname</MudNavLink>
    <MudNavLink Href="/operations/incidents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReportProblem">Barang Hilang / Rusak</MudNavLink>
    <MudNavLink Href="/operations/returns" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentReturn">Retur Barang</MudNavLink>
    <MudNavLink Href="/notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">Pusat Notifikasi</MudNavLink>

    <MudDivider Class="my-3" />
</MudNavMenu>
