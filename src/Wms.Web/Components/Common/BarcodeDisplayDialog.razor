@using MudBlazor
@using Wms.Application.Features.Barcode
@inject IBarcodeService BarcodeService

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column align-center pa-4 text-center">
            <MudText Typo="Typo.h6" Class="mb-1">@Title</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">@Subtitle</MudText>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 d-flex justify-center">
                <MudTabPanel Text="Barcode 1D (Code 128)" Icon="@Icons.Material.Filled.ViewColumn">
                    <div class="d-flex flex-column align-center">
                        <div style="max-width: 320px; width: 100%;">
                            @((MarkupString)_barcodeSvg)
                        </div>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="QR Code 2D" Icon="@Icons.Material.Filled.QrCode2">
                    <div class="d-flex flex-column align-center">
                        <div style="width: 180px; height: 180px;">
                            @((MarkupString)_qrSvg)
                        </div>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="Print">
            Cetak Label
        </MudButton>
        <MudButton Color="Color.Default" OnClick="Close">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = "Label Barcode & QR";

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Parameter]
    public string CodeValue { get; set; } = string.Empty;

    private string _barcodeSvg = string.Empty;
    private string _qrSvg = string.Empty;

    protected override void OnInitialized()
    {
        var val = string.IsNullOrWhiteSpace(CodeValue) ? "UNKNOWN" : CodeValue;
        _barcodeSvg = BarcodeService.GenerateBarcodeSvg(val, 80, true);
        _qrSvg = BarcodeService.GenerateQrCodeSvg(val, 180);
    }

    private void Print()
    {
        // Close and let browser print or trigger print via JS if needed
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close() => MudDialog.Cancel();
}

